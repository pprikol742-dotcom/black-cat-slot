{
  "name": "black-cat-slot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:vk": "cross-env VITE_PLATFORM=vk vite build --outDir dist-vk",
